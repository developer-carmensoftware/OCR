# ===========================================
# AI OCR Bank Receipt Backend Configuration
# ===========================================

# OpenRouter API (ใช้ LLM Vision ทำ OCR โดยตรง)
# สมัครได้ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_OCR_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_AP_INVOICE_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_SUGGESTION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LLM capacity pool (แก้คอขวดตอนหลาย user เรียก LLM พร้อมกัน) ──────────────
# Multi-key: คั่นด้วย comma. OpenRouter นับ rate-limit แยก bucket ต่อ key (แม้ account
# เดียวกัน) → ใส่หลาย key เพิ่ม throughput รวม. ปล่อยว่าง = ใช้ OPENROUTER_API_KEY เดิม.
OPENROUTER_API_KEYS=
# Per-key concurrency — vision (OCR) กับ text (suggestion) มี slot pool แยกกัน
# กัน head-of-line blocking. เป็น per-process: ภายใต้ --workers N เพดานจริง = N × ค่านี้.
LLM_VISION_CONCURRENCY_PER_KEY=6
LLM_TEXT_CONCURRENCY_PER_KEY=6
# Safety valve: รอ slot นานสุดกี่วิก่อนตอบ 429 Retry-After (0 = รอไม่จำกัด = พฤติกรรมเดิม)
LLM_MAX_QUEUE_WAIT_SECONDS=10

# ── LLM privacy enforcement (ส่งไป OpenRouter ทุก request; บังคับ no-train/no-collect) ──
# "deny" = route เฉพาะ endpoint ที่ไม่เก็บ/ไม่ train บนข้อมูล = ตัวบังคับทางเทคนิคของ
# คำสัญญาใน consent modal. อย่าตั้งเป็น "allow" ใน production (config.py จะ log CRITICAL).
LLM_DATA_COLLECTION=deny
# ZDR แบบเข้ม: ถ้าเปิด OpenRouter จะ reject request ที่ไม่มี ZDR endpoint (เช่น โมเดลที่
# เสิร์ฟผ่าน Google AI Studio อย่างเดียว). เปิดหลังยืนยันว่าโมเดลที่ใช้มี Vertex ให้ route.
LLM_REQUIRE_ZDR=false
# Provider allowlist (slug คั่น comma; ว่าง = ไม่จำกัด). Text/suggestion model อาจถูก route
# ไปหลายเจ้ารวม non-US/EU jurisdiction → pin ไว้ที่ US providers. Vision เป็น Google-only อยู่แล้ว.
LLM_TEXT_PROVIDER_ALLOWLIST=fireworks,deepinfra,digitalocean
LLM_VISION_PROVIDER_ALLOWLIST=
# ชื่อ provider (ตามที่ OpenRouter คืนใน response, เช่น "Google","DeepInfra") ที่เราคาดว่า
# traffic จะ route ไป — match แบบ case-insensitive substring. ถ้า route ไปที่อื่น ระบบยิง
# anomaly alert (llm_provider_out_of_policy). ว่าง = ปิด alert.
LLM_EXPECTED_PROVIDERS=Google,DeepInfra,Fireworks,DigitalOcean

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8010
# LOCAL DEV ONLY — must be false in any real deployment.
# app_debug is the single production switch: true disables the weak-secret rejection,
# the wildcard-CORS hard-fail and the admin/OCR key-separation check, AND returns full
# tracebacks to clients. Never copy this value to a deployed environment.
APP_DEBUG=true

# Upload Settings
MAX_FILE_SIZE_MB=20

# Database (PostgreSQL — local Postgres or Neon)
# Local:  postgresql+asyncpg://postgres:postgres@localhost:5432/carmen_ai
# Neon:   postgresql+asyncpg://USER:PASS@ep-xxx.aws.neon.tech/carmen_ai?ssl=require
# The app auto-normalizes `postgres://` / `postgresql://` URLs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carmen_ai

# Authentication — REQUIRED in production
# Generate SESSION_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OCR_JWT_SECRET=change-this-to-a-long-random-string-in-production
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_TTL_HOURS=8

# Admin Dashboard JWT — separate secret (REQUIRED in production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=change-this-to-another-long-random-string-in-production
ADMIN_JWT_TTL_HOURS=8

# Admin bootstrap — used ONCE by `python -m app.bootstrap_admin` then clear from env
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Application version — normally read from the repo-root VERSION file. Set this
# ONLY to override that (e.g. pinning a hotfix build); it is not the source of truth.
# APP_VERSION=

# ── Production / Render free-tier flags ─────────────────────────────────────
# CORS — comma-separated origins. Pin the EXACT frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost:3010
# Optional regex, for preview deploys only. Leave EMPTY unless you truly need it.
# WARNING: a pattern like ^https://[a-z0-9-]+\.vercel\.app$ matches EVERY site hosted
# on vercel.app — not just yours — and CORS runs with allow_credentials=true, so any
# attacker page at evil.vercel.app could make credentialed calls. The prod hard-fail
# only catches literal wildcards (".*"), so a too-broad pattern like that passes.
# Scope it to your own deployment, e.g. ^https://carmen-ocr-frontend-[a-z0-9]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Structured JSON log output (recommended in production for log aggregators).
LOG_JSON=false

# Trust X-Forwarded-For (set true only behind a proxy/load balancer, e.g. Render).
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1

# Comma-separated Carmen host(s), no scheme — SSRF allowlist for /auth/exchange.
# Empty = allow any https host (dev only). Pin in production.
ALLOWED_CARMEN_HOSTS=

# Legacy master key for the pre-RBAC admin endpoints (X-Admin-Key). Leave empty unless used.
MASTER_API_KEY=

# Shared secret for pg_cron/pg_net maintenance calls (/admin/anomaly/run,
# /admin/pricing/sync). MUST equal the Supabase Vault secret 'internal_job_token'.
# Empty = every scheduled job gets 401, so anomaly/budget detection and model-pricing
# refresh silently never run.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_JOB_TOKEN=

# Error tracking. Empty = Sentry no-ops (prod logs a warning); set it in production or
# server errors are only visible in ephemeral platform logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OneApp FileService (payment slip upload/download)
FILE_SERVICE_URL=https://host/Api/v1/External/FileService
FILE_SERVICE_API_KEY=

# Carmen AR posting (admin order review → ERP). Full endpoint URL + Authorization value.
CARMEN_AR_URL=
CARMEN_AR_TOKEN=
