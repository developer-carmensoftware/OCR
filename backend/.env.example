# ===========================================
# AI OCR Bank Receipt Backend Configuration
# ===========================================

# OpenRouter API (ใช้ LLM Vision ทำ OCR โดยตรง)
# สมัครได้ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_OCR_MODEL=google/gemini-2.0-flash-001
OPENROUTER_AP_INVOICE_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SUGGESTION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8010
APP_DEBUG=true

# Upload Settings
MAX_FILE_SIZE_MB=20

# Database (PostgreSQL — local Postgres or Neon)
# Local:  postgresql+asyncpg://postgres:postgres@localhost:5432/carmen_ai
# Neon:   postgresql+asyncpg://USER:PASS@ep-xxx.aws.neon.tech/carmen_ai?ssl=require
# The app auto-normalizes `postgres://` / `postgresql://` URLs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carmen_ai

# Carmen ERP
CARMEN_AUTHORIZATION=direct <token>

# Authentication — REQUIRED in production
# Generate SESSION_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OCR_JWT_SECRET=change-this-to-a-long-random-string-in-production
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_TTL_HOURS=8

# Admin Dashboard JWT — separate secret (REQUIRED in production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=change-this-to-another-long-random-string-in-production
ADMIN_JWT_TTL_HOURS=8

# Admin bootstrap — used ONCE by `python -m app.bootstrap_admin` then clear from env
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Application version (bump on every release)
APP_VERSION=1.0.0

# ── Production / Render free-tier flags ─────────────────────────────────────
# CORS — comma-separated origins for the Vercel frontend deployment.
ALLOWED_ORIGINS=http://localhost:3010
ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# Set to true on ephemeral hosts (Render free, Heroku). Skips on-disk archive
# directory creation and logs a warning that schedulers need a keep-alive ping.
EPHEMERAL_FILESYSTEM=false

# Disable nightly retention archive (CSV export to ./archives). Recommended on
# ephemeral hosts where the archive disk would be wiped on every restart.
RETENTION_ENABLED=true

# Structured JSON log output (recommended in production for log aggregators).
LOG_JSON=false
