# Normalize line endings: LF in the repo AND in the working tree on every OS.
# Without eol=lf, a Windows checkout (core.autocrlf=true) writes CRLF, and
# `npm run format:check` then fails on every frontend file — prettier defaults to
# endOfLine: lf — while CI on Linux stays green. That made the local check useless.
* text=auto eol=lf

# PowerShell is the one exception: keep CRLF so the script stays native on Windows.
*.ps1 text eol=crlf
